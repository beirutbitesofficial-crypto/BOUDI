# BOUDI CAFE POS - Environment configuration
# Do not commit real secrets to GitHub.

# Hostinger normally assigns PORT automatically. Leave PORT unset in hPanel
# unless Hostinger explicitly asks for a fixed port.
# PORT=5050

HOST=0.0.0.0
NODE_ENV=production

# REQUIRED: use a long, unique random secret in Hostinger.
SESSION_SECRET=change-me-to-a-long-random-string

# Production Hostinger websites use HTTPS.
COOKIE_SECURE=true

# Leave DATA_DIR unset on Hostinger.
# scripts/start-hostinger.js automatically stores the SQLite database,
# uploads and supplier files in persistent-data outside deployment versions.
# DATA_DIR=/absolute/path/to/persistent-data
