# Copy this file to ".env" on the server and fill in real values.
# Friend Cafe POS - Environment configuration

# Port the app listens on (Hostinger Node.js app usually sets this automatically)
PORT=5050

# Bind address (leave as 0.0.0.0 so the server is reachable)
HOST=0.0.0.0

# IMPORTANT: change this to a long random string before going live
SESSION_SECRET=change-me-to-a-long-random-string

# Set to "true" ONLY when the site is served over HTTPS
COOKIE_SECURE=false

# Optional persistent storage override.
# On Hostinger this can be left unset: the startup script automatically uses
# <domain-root>/persistent-data, outside hbuilds/versions, so deployments do not
# replace the database, uploads, or supplier invoice files.
# DATA_DIR=/absolute/path/to/persistent-data
